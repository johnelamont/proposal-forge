# Copy to .env.local and fill in values. Never commit .env.local.

# Local Supabase stack: `supabase start` prints both of these.
# The anon key is safe to expose to the browser; RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend (`uv run uvicorn app.main:app --reload`)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
