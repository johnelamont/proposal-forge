# Copy to .env and fill in values. Never commit .env.

ENVIRONMENT=development

# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local Supabase stack (`supabase status` prints these). The anon key is
# public. User tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/
# jwks.json; the JWT secret is only needed for older projects that still sign
# with HS256. The backend never uses the service-role key for per-user requests.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Zoho CRM (F6). Server-based application from the Zoho API Console; the
# refresh token is per user and stored encrypted, never configured here.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com
ZOHO_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/zoho/callback
ZOHO_LEADS_LAYOUT_ID=
# 32 random bytes, base64: python -c 'import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
TOKEN_ENCRYPTION_KEY=
# Where the Zoho callback sends the browser back to
FRONTEND_URL=http://localhost:3000

# Claude API (F1 job parsing and later features)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
