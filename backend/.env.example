# Copy to .env and fill in values. Never commit .env.

ENVIRONMENT=development

# Comma-free JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local Supabase stack (`supabase start` prints these). The JWT secret is used
# to verify user tokens; the backend never uses the service-role key for
# per-user requests.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=

# Claude API. Not needed until F1 is built.
ANTHROPIC_API_KEY=
