# Copy to .env and fill in values. Never commit .env.

ENVIRONMENT=development

# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local Supabase stack (`supabase status` prints these). The anon key is
# public. User tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/
# jwks.json; the JWT secret is only needed for older projects that still sign
# with HS256. The backend never uses the service-role key for per-user requests.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Claude API (F1 job parsing and later features)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
